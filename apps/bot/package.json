{
  "name": "@app/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:local": "wrangler dev --local",
    "build": "wrangler deploy --dry-run --outdir dist && node scripts/check-bundle.mjs dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "wire:fixture": "node ../../tooling/wire/render.mjs --template wrangler.template.jsonc --out wrangler.jsonc --map wiring.fixture.json --env stage"
  },
  "dependencies": {
    "@bot/config": "workspace:*",
    "@bot/core": "workspace:*"
  },
  "devDependencies": {
    "@app/eslint-config": "workspace:*",
    "@app/tsconfig": "workspace:*",
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/node": "^22.9.0",
    "eslint": "^9.27.0",
    "typescript": "^5.8.3",
    "wrangler": "^4.151.0"
  }
}
